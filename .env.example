NODE_ENV=development
PORT=3000

# Neon PostgreSQL (cadena con -pooler para la aplicacion)
DATABASE_URL=
# Neon PostgreSQL conexion directa (misma cadena SIN "-pooler" en el host). Usada por prisma migrate.
DIRECT_URL=

# Origenes permitidos para CORS (separados por coma)
FRONTEND_URL=http://localhost:5173

JWT_SECRET=
JWT_EXPIRES_IN=7d
# Opcional: none | lax | strict. Por defecto: "none" en produccion, "lax" en desarrollo
COOKIE_SAMESITE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=boda-invitacion

# Tamano maximo por imagen en MB
MAX_UPLOAD_MB=8

ADMIN_USERNAME=bodamc
ADMIN_PASSWORD=12345678
